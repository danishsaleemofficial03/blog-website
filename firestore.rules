rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS to the same email you put in VITE_ADMIN_EMAIL
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@yopmail.com";
    }

    match /posts/{postId} {
      // Everyone can read published posts. Only admin can read drafts.
      allow read: if resource.data.published == true || isAdmin();
      // ONLY the admin can create / edit / delete posts
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        // any logged-in user can comment, as themselves
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }
  }
}
